{
  "outputDirectory": ".",
  "buildCommand": "npm install",
  "devCommand": "vercel dev",
  "installCommand": "npm install",
  "redirects": [
    {
      "source": "/pillar/strategy",
      "destination": "/pillar/strategy/overview.html",
      "permanent": false
    },
    {
      "source": "/i3/strategy",
      "destination": "/i3/strategy/overview.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/sq-admin",
      "destination": "/sq-admin.html"
    },
    {
      "source": "/sales-queue",
      "destination": "/sales-queue.html"
    },
    {
      "source": "/call-list",
      "destination": "/sales-queue.html"
    },
    {
      "source": "/call-list/:path*",
      "destination": "/sales-queue.html"
    },
    {
      "source": "/outbound",
      "destination": "/sales-queue.html"
    },
    {
      "source": "/opportunities",
      "destination": "/opportunities.html"
    },
    {
      "source": "/calendar",
      "destination": "/calendar.html"
    },
    {
      "source": "/weekly-dashboard",
      "destination": "/weekly-dashboard.html"
    },
    {
      "source": "/settings",
      "destination": "/settings.html"
    },
    {
      "source": "/opportunities-report",
      "destination": "/sales-queue-report.html"
    },
    {
      "source": "/market-size",
      "destination": "/market-size.html"
    },
    {
      "source": "/automations",
      "destination": "/automations.html"
    },
    {
      "source": "/automation-apollo-enrichment",
      "destination": "/automation-apollo-enrichment.html"
    },
    {
      "source": "/automation-assignment-router",
      "destination": "/automation-assignment-router.html"
    },
    {
      "source": "/automation-deduplication",
      "destination": "/automation-deduplication.html"
    },
    {
      "source": "/automation-inbound-handler",
      "destination": "/automation-inbound-handler.html"
    },
    {
      "source": "/automation-lead-scoring",
      "destination": "/automation-lead-scoring.html"
    },
    {
      "source": "/automation-opportunity-creation",
      "destination": "/automation-opportunity-creation.html"
    },
    {
      "source": "/automation-reporting",
      "destination": "/automation-reporting.html"
    },
    {
      "source": "/automation-smart-tagging",
      "destination": "/automation-smart-tagging.html"
    },
    {
      "source": "/automation-webhook-orchestration",
      "destination": "/automation-webhook-orchestration.html"
    },
    {
      "source": "/crm-plan",
      "destination": "/crm-plan.html"
    },
    {
      "source": "/wave-contacts",
      "destination": "/wave-contacts.html"
    },
    {
      "source": "/webhook-contact-create",
      "destination": "/webhook-contact-create.html"
    },
    {
      "source": "/webhook-contact-update",
      "destination": "/webhook-contact-update.html"
    },
    {
      "source": "/webhook-inbound-message",
      "destination": "/webhook-inbound-message.html"
    },
    {
      "source": "/webhook-opportunity-create",
      "destination": "/webhook-opportunity-create.html"
    },
    {
      "source": "/webhook-opportunity-update",
      "destination": "/webhook-opportunity-update.html"
    },
    {
      "source": "/webhooks",
      "destination": "/webhooks.html"
    },
    {
      "source": "/achievements",
      "destination": "/achievements.html"
    },
    {
      "source": "/achievements/:path*",
      "destination": "/achievements.html"
    },
    {
      "source": "/email-templates",
      "destination": "/email-templates.html"
    },
    {
      "source": "/inbound",
      "destination": "/inbound.html"
    },
    {
      "source": "/sales-queue-report",
      "destination": "/sales-queue-report.html"
    },
    {
      "source": "/wave-1",
      "destination": "/wave-contacts.html?wave=1"
    },
    {
      "source": "/wave-2",
      "destination": "/wave-contacts.html?wave=2"
    },
    {
      "source": "/wave-3",
      "destination": "/wave-contacts.html?wave=3"
    },
    {
      "source": "/backup",
      "destination": "/wave-contacts.html?backup=1"
    },
    {
      "source": "/queue-report",
      "destination": "/sales-queue-report.html"
    },
    {
      "source": "/queue",
      "destination": "/sales-queue.html"
    },
    {
      "source": "/pillar",
      "destination": "/pillar/index.html"
    },
    {
      "source": "/pillar/strategy/:path*",
      "destination": "/pillar/strategy/:path*"
    },
    {
      "source": "/pillar/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/pillar/strategy-shared.css",
      "destination": "/pillar/strategy/shared.css"
    },
    {
      "source": "/pillar/strategy-shared.js",
      "destination": "/pillar/strategy/shared.js"
    },
    {
      "source": "/i3",
      "destination": "/i3/index.html"
    },
    {
      "source": "/i3/crm",
      "destination": "/i3/crm.html"
    },
    {
      "source": "/i3/crm-plan",
      "destination": "/crm-plan.html"
    },
    {
      "source": "/i3/automations",
      "destination": "/automations.html"
    },
    {
      "source": "/i3/webhooks",
      "destination": "/webhooks.html"
    },
    {
      "source": "/i3/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/i3/strategy/:path*",
      "destination": "/i3/strategy/:path*"
    },
    {
      "source": "/i3/strategy-shared.css",
      "destination": "/i3/strategy/shared.css"
    },
    {
      "source": "/i3/strategy-shared.js",
      "destination": "/i3/strategy/shared.js"
    }
  ],
  "functions": {
    "api/**/*.js": {
      "memory": 512,
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron-sync-apollo",
      "schedule": "*/10 * * * *"
    }
  ]
}
